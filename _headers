# Service Worker and manifest must NEVER be cached by the browser/CDN
# Otherwise users will sit on old versions of the app indefinitely.
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

# Static assets — long cache, they have content-hashed names or are stable
/assets/*
  Cache-Control: public, max-age=2592000

# All other paths — minimal caching, let browser revalidate
/*
  Cache-Control: public, max-age=0, must-revalidate
